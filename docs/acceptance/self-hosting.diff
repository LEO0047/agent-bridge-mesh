+    assert.ok(record, 'running record must exist before the first await');
+    assert.equal(record.pid, launch.child.pid);
+    assert.equal(record.process_identity, processIdentity(launch.child.pid!));
+    assert.ok(record.process_identity);
+    assert.deepEqual(record.command, command);
+    assert.equal(record.cwd, f.root);
+    assert.equal(record.status, 'running');
+    launch.release();
+    const result = await pending;
+    assert.equal(result.passed, exitCode === 0);
+    const done = f.db.get('test_runs', record.id);
+    assert.equal(done.status, exitCode === 0 ? 'completed' : 'failed');
+    assert.equal(done.exit_code, exitCode);
+    assert.ok(done.ended_at);
+    assert.equal(alive(record.pid), false);
+    assert.deepEqual(f.db.all('runs'), []);
+  });
+}
