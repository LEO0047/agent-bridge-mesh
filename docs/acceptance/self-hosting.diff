+
+// The outer Bridge sandbox may deny ps/sysctl and signals. Model only that OS boundary;
+// runTests, Store, Service and Engine execute unchanged, including sandbox profile creation.
+function controlledSpawn(
+  t: TestContext,
+  os: ReturnType<typeof processBoundary>,
+  outcome: number | 'output' = 0,
+) {
+  let tracked: ReturnType<typeof os.create> | undefined;
+  const stub = t.mock.method(cp, 'spawn', (file, args, options) => {
+    assert.equal(file, '/usr/bin/sandbox-exec');
+    assert.equal(args?.[0], '-p');
+    assert.match(String(args?.[1]), /\(deny default\)/);
+    assert.match(String(args?.[1]), /credentials/);
+    assert.equal(options?.detached, true);
+    tracked = os.create();
+    return tracked.child;
+  });
+  syncBuiltinESMExports();
+  t.after(() => {
+    stub.mock.restore();
+    syncBuiltinESMExports();
+  });
+  return {
+    get child() {
+      assert.ok(tracked, 'runner must spawn a child');
+      return tracked.child;
+    },
+    release() {
+      if (outcome === 'output') this.child.stdout.write('x'.repeat(2100000));
+      else this.child.close(outcome);
+    },
+    get calls() {
+      return stub.mock.callCount();
+    },
+  };
