+test('synthesis persists its test child and cached validation starts no second child', async (t) => {
+  const f = fixture(t);
+  const s = new Service(f.db, f.config);
+  const c = s.create({
+    goal: 'integration fixture',
+    initiator: 'codex',
+    mode: 'collaborative_report',
+    required_sections: [],
+    require_evidence: false,
+    test_command: ['node', '--test'],
+  }).id;
+  const repo = join(f.root, 'repo');
+  mkdirSync(repo);
+  // Git is another sandbox-restricted OS boundary; snapshot assertions still execute.
+  const sha = 'a'.repeat(40);
+  f.db.put('collaborations', {
+    ...s.collab(c),
+    mode: 'collaborative_coding',
+    phase: 'synthesis',
+    work: { paths: { integration: repo } },
+  });
+  const e = new Engine(s, { codex: inert, claude: inert });
+  t.mock.method(s.worktrees, 'integrate', () => ({ ok: true, sha, path: repo }));
+  let stop = new AbortController();
+  t.mock.method(e, 'turn', async () => {
+    if (s.collab(c).phase === 'review') stop.abort();
+    return { summary: 'test fixture', ready_for_next_phase: true };
+  });
+  const launch = controlledSpawn(t, f.os);
+  const pending = e.run(c, stop.signal);
+  // The synthesis turn is awaited before the runner starts.
+  await new Promise((resolve) => setImmediate(resolve));
+  const [running] = f.db.all('test_runs', c);
+  assert.ok(running, 'integration path must register the child');
+  assert.equal(running.status, 'running');
+  assert.equal(running.process_identity, processIdentity(launch.child.pid!));
+  launch.release();
+  await pending;
+  assert.equal(f.db.get('test_runs', running.id).status, 'completed');
+  assert.equal(s.collab(c).code_test.passed, true);
+  assert.equal(s.collab(c).code_integrated, true);
+  f.db.put('collaborations', { ...s.collab(c), phase: 'synthesis', phase_step: 0 });
+  stop = new AbortController();
+  await e.run(c, stop.signal);
+  assert.equal(s.collab(c).code_test.reused, true);
+  assert.equal(launch.calls, 1);
+  assert.deepEqual(f.os.gitCalls, [
+    ['rev-parse', 'HEAD'],
+    ['diff', 'HEAD', '--name-only'],
+    ['ls-files', '--others', '--exclude-standard'],
+    ['rev-parse', 'HEAD'],
+    ['diff', 'HEAD', '--name-only'],
+    ['ls-files', '--others', '--exclude-standard'],
+  ]);
+  assert.equal(f.db.all('test_runs', c).length, 1);
+  assert.deepEqual(f.db.all('runs'), []);
+});
