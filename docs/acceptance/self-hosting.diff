+import { test, type TestContext } from 'node:test';
+import assert from 'node:assert/strict';
+import cp from 'node:child_process';
+import { syncBuiltinESMExports } from 'node:module';
+import { EventEmitter, once } from 'node:events';
+import { PassThrough } from 'node:stream';
+import { copyFileSync, mkdtempSync, rmSync, mkdirSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { loadConfig, projectRoot } from '../src/config.js';
+import { Store } from '../src/database/sqlite.js';
+import { Service, TestRuns } from '../src/service.js';
+import { Engine } from '../src/collaboration-engine.js';
+import { runTests, type TestProcessRegistry } from '../src/tasks/test-runner.js';
+import { processIdentity } from '../src/adapters/process.js';
+import type { Adapter } from '../src/adapters/types.js';
+
+const realSpawn = cp.spawn;
+const realSpawnSync = cp.spawnSync;
+let nextPid = 42000;
+
+class TestChild extends EventEmitter {
+  pid = nextPid++;
+  exitCode: number | null = null;
+  signalCode: string | null = null;
+  stdout = new PassThrough();
+  stderr = new PassThrough();
+  stdin = new PassThrough();
+  birth = 'Mon Sep 28 16:00:00 2026';
+  uid = '501';
+  comm = '/bin/sleep';
+  live = true;
+  close(code: number | null, signal: string | null = null) {
+    if (!this.live) return;
+    this.live = false;
+    this.exitCode = code;
+    this.signalCode = signal;
+    this.stdout.end();
+    this.stderr.end();
+    this.emit('exit', code, signal);
+    this.emit('close', code, signal);
+  }
+  kill(signal: string) {
+    queueMicrotask(() => this.close(null, signal));
+    return true;
+  }
+}
+
+function processBoundary(t: TestContext) {
+  const children = new Map<number, TestChild>();
+  const signals: { pid: number; signal: string | number | undefined }[] = [];
+  const gitCalls: string[][] = [];
+  const ps = t.mock.method(cp, 'spawnSync', (file, args, options) => {
+    if (file === 'git') {
+      const command = args!.slice(2);
+      gitCalls.push(command);
+      assert.ok(
+        [
+          'rev-parse HEAD',
+          'diff HEAD --name-only',
+          'ls-files --others --exclude-standard',
+        ].includes(command.join(' ')),
+        'unexpected Git command: ' + command.join(' '),
+      );
+      return { status: 0, stdout: command[0] === 'rev-parse' ? 'a'.repeat(40) : '', stderr: '' };
+    }
+    if (file !== 'ps') return realSpawnSync(file, args, options);
+    const child = children.get(Number(args?.[args.indexOf('-p') + 1]));
+    const fields = (args || []).filter((_, index) => args?.[index - 1] === '-o');
+    const stdout = child?.live
+      ? fields
+          .map(
+            (field) => ({ 'lstart=': child.birth, 'uid=': child.uid, 'comm=': child.comm })[field],
+          )
+          .join(' ') + '\n'
+      : '';
+    return { status: child?.live ? 0 : 1, stdout, stderr: '', signal: null, pid: 1, output: [] };
+  });
+  const kill = t.mock.method(process, 'kill', (pid, signal) => {
+    const child = children.get(Math.abs(pid));
+    if (!child?.live) throw Object.assign(Error('No such process'), { code: 'ESRCH' });
+    if (signal !== 0) {
+      signals.push({ pid, signal });
+      child.kill(String(signal));
+    }
+    return true;
+  });
+  syncBuiltinESMExports();
+  t.after(() => {
+    for (const child of children.values()) child.close(0);
+    ps.mock.restore();
+    kill.mock.restore();
+    syncBuiltinESMExports();
+  });
+  return {
+    signals,
+    gitCalls,
+    create() {
+      const child = new TestChild();
+      children.set(child.pid, child);
+      const closed = new Promise<void>((resolve) => child.once('close', () => resolve()));
+      return { child, closed };
+    },
+  };
+}
+const inert: Adapter = {
+  async turn() {
+    throw Error('Recovery must not launch an agent');
+  },
+};
+
+function fixture(t: TestContext) {
+  const root = mkdtempSync(join(tmpdir(), 'bridge-orphan-'));
+  copyFileSync(
+    join(projectRoot, 'agent-bridge.config.yaml'),
+    join(root, 'agent-bridge.config.yaml'),
+  );
+  const previous = process.env.AGENT_BRIDGE_STATE;
+  process.env.AGENT_BRIDGE_STATE = join(root, 'state');
+  let config;
+  try {
+    config = loadConfig(root);
+  } finally {
+    if (previous === undefined) delete process.env.AGENT_BRIDGE_STATE;
+    else process.env.AGENT_BRIDGE_STATE = previous;
+  }
+  const f = { root, config, db: new Store(config.db), os: processBoundary(t) };
+  t.after(() => {
+    f.db.close();
+    rmSync(root, { recursive: true, force: true });
+  });
